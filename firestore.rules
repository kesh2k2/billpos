rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ════════════════════════════════════════════════════════════════
    //  HELPER FUNCTIONS
    //  Custom claims come from the ID token — free to check, no reads.
    // ════════════════════════════════════════════════════════════════

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ════════════════════════════════════════════════════════════════
    //  FEEDBACK  — moderation queue
    //  ────────────────────────────────────────────────────────────────
    //  • Public can read ONLY approved feedback (drives TestimonialSection)
    //  • Signed-in users can create feedback — always forced to 'pending'
    //  • Only admins can read pending/rejected, update status, or delete
    // ════════════════════════════════════════════════════════════════
    match /feedback/{feedbackId} {

      // Public read, but ONLY approved docs.
      allow read: if resource.data.status == 'approved';

      // Admins can read everything (pending, rejected, approved).
      allow read: if isAdmin();

      // Signed-in users can create — but every field is validated
      // and status is forced to 'pending'. They cannot self-approve.
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(
             ['name','business','comment','rating','status','userId','createdAt']
           )
        && request.resource.data.keys().hasOnly(
             ['name','business','comment','rating','status','userId','createdAt']
           )
        && request.resource.data.status == 'pending'
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.business is string
        && request.resource.data.business.size() > 0
        && request.resource.data.business.size() <= 100
        && request.resource.data.comment is string
        && request.resource.data.comment.size() > 0
        && request.resource.data.comment.size() <= 1000
        && request.resource.data.createdAt == request.time;

      // Only admins can approve / reject / delete.
      allow update, delete: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════════
    //  PACKAGES  — public catalog, admin-managed
    // ════════════════════════════════════════════════════════════════
    match /packages/{packageId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════════
    //  USERS  — profile docs (optional, used if you store extra data)
    //  ════════════════════════════════════════════════════════════════
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // Users can create their own profile doc on first sign-in,
      // but cannot set any privileged fields.
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['email','displayName','createdAt'])
        && request.resource.data.email is string
        && request.resource.data.createdAt == request.time;

      // Users can update only their own displayName. Never roles.
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName']);

      // No client deletes — use Admin SDK if account removal is needed.
      allow delete: if false;
    }

    // ════════════════════════════════════════════════════════════════
    //  DEFAULT DENY  — anything not matched above is blocked.
    // ════════════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
